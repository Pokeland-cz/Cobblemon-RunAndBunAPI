{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "${maven_group}.FabricCommon"
    ],
    "client": [
      "${maven_group}.FabricClient"
    ]
  },
  "mixins": [
    "ctengine.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "~1.21",
    "java": ">=21",
    "architectury": ">=13.0.2",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
